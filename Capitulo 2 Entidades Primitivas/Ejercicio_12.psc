//Clase 2 Capitulo: Entidades Primitivas -> Escribir la siguiente expresión en forma de expresión algorítmica.  (Fórmula de Bhaskara, es una fórmula cuadrática, una ecuación de segundo grado) (pseudocódigo)
Proceso Ejercicio_12
	Definir a,b,c,resultado Como Real;
	Escribir "Digite el valor de A: ";//Dijite 2
	Leer a;
	Escribir "Digite el valor de B: ";//Dijite 10
	Leer b;
	Escribir "Digite el valor de C: ";//Dijite 3
	Leer c;
	
	resultado <-(-b + rc(b^2 - 4 * a * c))/(2*a);//El resultado es -0.3205505282
	
	Escribir "El resultado es: ",resultado;
	
	resultado <-(-b - rc(b^2 - 4 * a * c))/(2*a);//El resultado es -4.6794494718
	
	Escribir "El resultado es: ",resultado;
FinProceso
