Proceso Ejercio_6
	//Prioridad de los operadores aritmeticos
	Definir resultado,num1,num2 Como Entero;
	Escribir  "Digite un numero: "; //Dijitar el 54
	Leer num1;
	Escribir "Digite otro numero: "; //Dijitar el 10
	Leer num2;
	
	resultado <- num1+num2; //Suma de variables
	
	Escribir "El resultado es: ",resultado; //El resultado es 64
	
FinProceso
