//Clase 2 Capitulo: Entidades Primitivas -> Determinar la solución lógica de la siguiente operación: (pseudocódigo) 
Proceso Ejercicio_13
	
	Definir a,b Como Real;

	Definir resultado Como Logico;
	Escribir "Dijite el valor de A: ";//Dijite 10
	Leer a;
	Escribir "Dijite el valor de B: ";//Dijite 5
	Leer b;
	
	resultado <- ((3+5*8) < 3 y ((-6/3*4)+2<2)) o (a>b);
	
	Escribir "El resultado es: ",resultado;//El resultado es Verdadero
FinProceso
