//Calcular la suma de los "N" primeros números (Pseudocódigo, Ciclo Para) .
Proceso Ejercicio_38
	
	Definir num1, suma, num2 Como Entero;
	suma <- 0;
	Escribir "Digite N:";
	Leer num1;
	Para num2 <- 1  Hasta num1 Hacer
	 suma <- suma + num2;
	FinPara
	Escribir "La suma es: ", suma;
FinProceso
