//Capitulo 3 Suma de 2 números (a+b) (Diagrama Estructurado N-S, Nassi-Schneideman) 
Proceso Ejercicio_16
	// Este es el programa en Diagrama N-S
	Definir a,b,resultado como entero;
	a <- 10;
	Escribir "Digite un Numero: ";
	Leer b;
	resultado <- a + b;
	Escribir "El resultado es: ",resultado;
FinProceso
